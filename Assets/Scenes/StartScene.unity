  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1. Split into 2 teams with at least 2 players each.\n2. Team Green goes
    first \u2014 one player gives clues for 1 minute while teammates guess the word.\n3.
    You cannot say the 5 banned words.\n4. Each team has 3 skips for the entire game.\n5.
    When the timer ends, an intermission screen will appear.\n6. Click the blue arrow
    in the bottom-left to continue.\n7. Team Red then plays for 1 minute with the
    same rules.\n8. Turns alternate between teams. Each player should take a turn
    giving clues before repeating.\n\nThe game automatically ends after each player
    gets a turn. The team with the most correct guesses wins (though saying a banned
    word loses a point)."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: faadb63ec420dce499e29080a883d7af, type: 2}
  m_sharedMaterial: {fileID: 7565219159334217553, guid: faadb63ec420dce499e29080a883d7af, type: 2}
